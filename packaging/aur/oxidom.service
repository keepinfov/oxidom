[Unit]
Description=oxidom Xray tunnel daemon
Wants=network-online.target
After=network-online.target dbus.service

[Service]
# Passing the ports on the command line pins them: with the daemon reachable
# over the system bus, an unpinned port is a setting any client can rewrite,
# which moves the inbound out from under everyone else using it. Edit the
# numbers here (systemctl edit oxidom) rather than in the GUI.
ExecStart=/usr/bin/oxidom daemon --system --socks-port 10808 --http-port 10809
User=oxidom
Group=oxidom
StateDirectory=oxidom
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
