# Maintainer: keepinfov <218463407+keepinfov@users.noreply.github.com>
pkgname=oxidom-git
pkgver=0.1.0.r120.gb92035a
pkgrel=1
pkgdesc="Native Linux desktop Xray / v2ray client built with GTK4 + libadwaita in Rust"
arch=(x86_64 aarch64)
url="https://github.com/keepinfov/oxidom"
license=(MIT)
depends=(gcc-libs gdk-pixbuf2 glib2 glibc gtk4 hicolor-icon-theme libadwaita pango)
# Every provider of an Xray core — xray, xray-bin, xray-git — lives in the AUR,
# and pacman cancels an entire transaction when one target is missing. As a hard
# dependency it therefore took gtk4 and libadwaita down with it, and `makepkg -si`
# failed before it reached a compiler. oxidom starts without a core and says so
# in a banner; connecting and checking latency both need one.
optdepends=('xray: the proxy core — nothing can connect without it (AUR)'
            'tun2socks: TUN interface mode'
            'nftables: per-app routing for `oxidom run`')
makedepends=(git cargo)
provides=("oxidom=$pkgver")
conflicts=(oxidom)
# makepkg's -flto=auto leaks into CFLAGS, and ring's build script hands those to
# cc(1). GCC then emits slim LTO objects: the C symbols live in .gnu.lto_* IR
# sections instead of the ELF symbol table, so the linker cannot resolve them
# (undefined ring_core_0_17_14__*). Cargo does its own LTO via [profile.release].
options=(!lto)
# The units and the sysusers file are not Arch-specific and are not copies: the
# clone above already carries them, so they are installed from it. Listing them
# as sources again would mean a second copy in the AUR repository and a checksum
# that goes stale the moment the tracked file changes — which it once did,
# stopping makepkg at the validity check before it reached a compiler.
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf '%s.r%s.g%s' \
    "$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  # A builder with rustup installed otherwise resolves cargo through whatever
  # toolchain that user last defaulted to, which need not exist here.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/oxidom "$pkgdir/usr/bin/oxidom"
  install -Dm755 target/release/oxidom-gui "$pkgdir/usr/bin/oxidom-gui"
  install -Dm644 data/dev.keepinfov.oxidom.desktop \
    "$pkgdir/usr/share/applications/dev.keepinfov.oxidom.desktop"
  install -Dm644 data/dev.keepinfov.oxidom.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.keepinfov.oxidom.svg"
  install -Dm644 data/dev.keepinfov.oxidom-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/dev.keepinfov.oxidom-symbolic.svg"
  # Adwaita ships no filter icon under any name, so the funnel travels with the
  # application. Without it the Filter pill draws an empty square.
  install -Dm644 data/icons/oxidom-funnel-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/actions/oxidom-funnel-symbolic.svg"
  install -Dm644 data/dev.keepinfov.oxidom.metainfo.xml \
    "$pkgdir/usr/share/metainfo/dev.keepinfov.oxidom.metainfo.xml"
  install -Dm644 data/dev.keepinfov.oxidom.Daemon.conf \
    "$pkgdir/usr/share/dbus-1/system.d/dev.keepinfov.oxidom.Daemon.conf"
  install -Dm644 data/dev.keepinfov.oxidom.Daemon.service \
    "$pkgdir/usr/share/dbus-1/system-services/dev.keepinfov.oxidom.Daemon.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/systemd/oxidom.service \
    "$pkgdir/usr/lib/systemd/system/oxidom.service"
  install -Dm644 packaging/systemd/oxidom@.service \
    "$pkgdir/usr/lib/systemd/system/oxidom@.service"
  install -Dm644 packaging/systemd/oxidom.sysusers \
    "$pkgdir/usr/lib/sysusers.d/oxidom.conf"
}
