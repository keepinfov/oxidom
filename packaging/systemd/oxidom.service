[Unit]
Description=oxidom Xray tunnel daemon
Wants=network-online.target
After=network-online.target dbus.service

[Service]
# No --socks-port/--http-port here: passing them pins the ports, and a pinned
# port is one the daemon refuses to change, so Settings shows the row locked and
# a desktop user cannot move their own proxy off 10808. The daemon reads
# /var/lib/oxidom/config.toml instead, which is the file the GUI edits.
#
# Pinning is still the right answer on a machine where several people can drive
# this daemon — everyone in group oxidom or wheel can, per the D-Bus policy —
# because moving an inbound moves it out from under all of them. Pin it there:
#
#   systemctl edit oxidom
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/oxidom daemon --system --socks-port 10808 --http-port 10809
ExecStart=/usr/bin/oxidom daemon --system
User=oxidom
Group=oxidom
StateDirectory=oxidom
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
